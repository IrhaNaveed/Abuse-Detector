# Copy this file to .env and fill in real values. Never commit .env.

# LLM
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: override the moderation prompt entirely for your platform's context.
# Must keep the same 5 criteria keys and JSON output shape the evaluator parses
# (see _DEFAULT_SYSTEM_PROMPT in app/core/config.py). Leave unset to use the default.
# SYSTEM_PROMPT="You are a content moderation AI for ..."

# Criterion weights (don't need to sum to 1, normalized automatically)
WEIGHT_TOXICITY_HATE_SPEECH=0.25
WEIGHT_HARASSMENT_THREATS=0.20
WEIGHT_LANGUAGE_APPROPRIATENESS=0.20
WEIGHT_SPAM_INTEGRITY=0.15
WEIGHT_POLITICAL_SENSITIVITY=0.20

# Recommendation thresholds (0-100, applied to the weighted overall score)
THRESHOLD_APPROVED=70
THRESHOLD_FLAGGED=40

# Single-criterion override: political_sensitivity at or below this forces
# BLOCKED regardless of the overall score. Set to -1 to disable this override.
POLITICAL_BLOCK_THRESHOLD=30
